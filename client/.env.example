# ============================================================================
# Capital Agro ERP — Client environment
# Copy this file to client/.env and adjust if needed.
#   cp .env.example .env
# ============================================================================

# Base URL for the API. Defaults to "/api/v1" (relative path — in development
# the Vite dev server proxies /api to http://localhost:4000, see vite.config.ts).
# In production, point this at the deployed API, e.g.:
#   VITE_API_BASE="https://api.example.com/api/v1"
VITE_API_BASE="/api/v1"