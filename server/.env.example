# ============================================================================
# Capital Agro ERP — Server environment
# Copy this file to server/.env and fill in real values.
#   cp .env.example .env
# ============================================================================

# PostgreSQL connection string (REQUIRED)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/capital_agro"

# JWT signing secret — use a long random string in production (REQUIRED for prod)
JWT_SECRET="change-me-to-a-long-random-string"

# Server port (default: 4000)
PORT=4000

# Allowed CORS origin for the client (default: http://localhost:5173)
CLIENT_ORIGIN="http://localhost:5173"

# Node environment: development | production (default: development)
NODE_ENV="development"

# Set to "true" to disable the scheduled reports job (default: false)
DISABLE_SCHEDULER="false"